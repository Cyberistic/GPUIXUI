+
+    #[test]
+    fn a_simulation_keeps_its_state_between_frames() {
+        let context = WgpuContext::new_offscreen().expect("an adapter");
+        let extent = Size { width: DevicePixels(SIDE), height: DevicePixels(SIDE) };
+        let mut renderer = WgpuRenderer::new_offscreen(&context, extent).expect("a renderer");
+        let mut frame = |time: f32| {
+            let mut counting = shader(
+                "fn shade(p: vec2f) -> vec4f { return vec4f(textureSampleLevel(simulation_state, backdrop_sampler, vec2f(0.5), 0.).x, 0., 0., 1.); }",
+                false,
+            );
+            counting.time = time;
+            counting.simulation = Some(gpui::ShaderSimulation {
+                key: 1,
+                source: SharedString::from(COUNTER.to_string()),
+                grid: [16, 16],
+                uniform: [[0.0; 4]; 6],
+            });
+            let mut scene = Scene::default();
+            scene.insert_primitive(counting);
+            scene.finish();
+            let mut pixels = vec![0; (SIDE * SIDE * 4) as usize];
+            renderer.render_to_pixels(&scene, extent, &mut pixels).expect("renders");
+            at(&pixels, 20, 20)[0]
+        };
+        assert_eq!(frame(10.0), 72, "a new grid warms up");
+        assert_eq!(frame(10.0 + 2.0 * gpui::SIMULATION_DT), 74, "two more fixed steps");
+        assert_eq!(frame(10.0 + 2.0 * gpui::SIMULATION_DT), 74, "redrawing a frame does not step");
+    }
