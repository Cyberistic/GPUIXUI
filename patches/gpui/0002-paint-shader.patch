+/// The WGSL every [`PaintShader`] is compiled with: its `frame` uniform, `size()` and `backdrop_at()`.
+pub const SHADER_PRELUDE: &str = r#"
+struct ShaderFrame {
+    bounds: vec4f,
+    viewport: vec2f,
+    scale: f32,
+    time: f32,
+    params: array<vec4f, 64>,
+}
+@group(0) @binding(0) var<uniform> frame: ShaderFrame;
+@group(0) @binding(1) var backdrop: texture_2d<f32>;
+@group(0) @binding(2) var backdrop_sampler: sampler;
+@group(0) @binding(3) var simulation_state: texture_2d<f32>;
+@group(0) @binding(4) var shader_data: texture_2d<f32>;
+struct ShaderVarying {
+    @builtin(position) position: vec4f,
+    @location(0) point: vec2f,
+}
+@vertex fn gpui_shader_vertex(@builtin(vertex_index) index: u32) -> ShaderVarying {
+    var unit = array<vec2f, 6>(vec2f(0., 0.), vec2f(1., 0.), vec2f(0., 1.), vec2f(0., 1.), vec2f(1., 0.), vec2f(1., 1.));
+    let device = frame.bounds.xy + unit[index] * frame.bounds.zw;
+    var out: ShaderVarying;
+    out.position = vec4f(device / frame.viewport * vec2f(2., -2.) + vec2f(-1., 1.), 0., 1.);
+    out.point = unit[index] * frame.bounds.zw / frame.scale;
+    return out;
+}
+fn shader_data_at(index: u32) -> vec4f {
+    return textureLoad(shader_data, vec2u(index % 1024u, index / 1024u), 0);
+}
+fn size() -> vec2f { return frame.bounds.zw / frame.scale; }
+fn backdrop_at(point: vec2f) -> vec4f {
+    let device = frame.bounds.xy + point * frame.scale;
+    return textureSampleLevel(backdrop, backdrop_sampler, device / frame.viewport, 0.);
+}
+@fragment fn gpui_shader_fragment(in: ShaderVarying) -> @location(0) vec4f { return shade(in.point); }
+"#;
+
+/// A fragment shader drawn over `bounds` in painter order. `source` is WGSL
+/// defining `shade(point: vec2f) -> vec4f`, returning premultiplied colour.
+#[derive(Clone, Debug)]
+pub struct PaintShader {
+    pub order: DrawOrder,
+    pub bounds: Bounds<ScaledPixels>,
+    pub content_mask: ContentMask<ScaledPixels>,
+    pub source: crate::SharedString,
+    pub scale: f32,
+    pub time: f32,
+    pub params: [[f32; 4]; SHADER_PARAMS],
+    pub reads_backdrop: bool,
+    pub simulation: Option<ShaderSimulation>,
+    /// Per-frame tables too large for `frame.params`, read with `shader_data_at`.
+    pub data: Option<std::sync::Arc<[[f32; 4]]>>,
+}
+
+/// How many `vec4f`s a [`PaintShader`] can pass in `frame.params`.
+pub const SHADER_PARAMS: usize = 64;
+
+/// A grid that keeps its state between frames and steps a fluid solver before the frame is drawn.
+/// `source` is WGSL with the compute entry points named in [`SIMULATION_PASSES`]; the shader samples
+/// the latest state from `simulation_state`.
+#[derive(Clone, Debug)]
+pub struct ShaderSimulation {
+    pub key: u64,
+    pub source: crate::SharedString,
+    pub grid: [u32; 2],
+    pub uniform: [[f32; 4]; 6],
+}
+
+/// Fixed simulation step, so the result does not depend on frame rate.
+pub const SIMULATION_DT: f32 = 1.0 / 60.0;
+const SIMULATION_MAX_STEPS: usize = 4;
+const SIMULATION_WARMUP_STEPS: usize = 72;
+const SIMULATION_JACOBI: usize = 14;
+
+/// One step's compute passes as `(entry, [state in, state out, a in, b in, scalar out])`. Textures 0
+/// and 1 are the rgba16float state pair, swapped each step; 2 to 5 are r32float scalars.
+pub const SIMULATION_PASSES: [(&str, [usize; 5]); 7] = [
+    ("curl", [0, 1, 5, 3, 2]),
+    ("forces", [0, 1, 2, 3, 5]),
+    ("divergence", [1, 0, 2, 4, 3]),
+    ("jacobi", [1, 0, 4, 3, 5]),
+    ("jacobi", [1, 0, 5, 3, 4]),
+    ("project", [1, 0, 4, 3, 2]),
+    ("advect", [0, 1, 2, 3, 5]),
+];
+
+/// The order of [`SIMULATION_PASSES`] for one step.
+pub fn simulation_pass_order() -> impl Iterator<Item = usize> {
+    [0, 1, 2]
+        .into_iter()
+        .chain((0..SIMULATION_JACOBI).map(|index| 3 + (index & 1)))
+        .chain([5, 6])
+}
+
+/// Steps to reach `target` from a grid last stepped to `previous`: `(steps, time before the first,
+/// start over)`. A hitch skips time; a new grid or a jump back warms up.
+pub fn simulation_schedule(previous: Option<f32>, target: f32) -> (usize, f32, bool) {
+    match previous {
+        Some(time) if target >= time - 1e-4 => {
+            let due = ((target - time) / SIMULATION_DT + 1e-3).floor() as usize;
+            let steps = due.min(SIMULATION_MAX_STEPS);
+            (steps, target - steps as f32 * SIMULATION_DT, false)
+        }
+        _ => (
+            SIMULATION_WARMUP_STEPS,
+            target - SIMULATION_WARMUP_STEPS as f32 * SIMULATION_DT,
+            true,
+        ),
+    }
+}
+
+impl From<PaintShader> for Primitive {
+    fn from(shader: PaintShader) -> Self {
+        Primitive::Shader(shader)
+    }
+}
