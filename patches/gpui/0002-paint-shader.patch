diff --git a/crates/gpui_wgpu/src/wgpu_shader.rs b/crates/gpui_wgpu/src/wgpu_shader.rs
new file mode 100644
index 0000000..77af00d
--- /dev/null
+++ b/crates/gpui_wgpu/src/wgpu_shader.rs
@@ -0,0 +1,419 @@
+use anyhow::{Result, anyhow};
+use collections::HashMap;
+use gpui::{PaintShader, SHADER_PRELUDE, Scene, SharedString};
+use std::sync::Arc;
+
+const MAX_PIPELINES: usize = 64;
+const UNIFORM_SIZE: u64 = 160;
+
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct ShaderFrame {
+    bounds: [f32; 4],
+    viewport: [f32; 2],
+    scale: f32,
+    time: f32,
+    params: [[f32; 4]; 8],
+}
+
+struct Clip {
+    x: u32,
+    y: u32,
+    width: u32,
+    height: u32,
+}
+
+fn clip_of(shader: &PaintShader, width: u32, height: u32) -> Option<Clip> {
+    let visible = shader.bounds.intersect(&shader.content_mask.bounds);
+    let x0 = (visible.origin.x.0.floor().max(0.0) as u32).min(width);
+    let y0 = (visible.origin.y.0.floor().max(0.0) as u32).min(height);
+    let x1 = ((visible.origin.x.0 + visible.size.width.0).ceil().max(0.0) as u32).min(width);
+    let y1 = ((visible.origin.y.0 + visible.size.height.0).ceil().max(0.0) as u32).min(height);
+    (x1 > x0 && y1 > y0).then_some(Clip { x: x0, y: y0, width: x1 - x0, height: y1 - y0 })
+}
+
+pub(crate) struct WgpuShaders {
+    device: Arc<wgpu::Device>,
+    queue: Arc<wgpu::Queue>,
+    format: wgpu::TextureFormat,
+    bind_group_layout: wgpu::BindGroupLayout,
+    pipeline_layout: wgpu::PipelineLayout,
+    sampler: wgpu::Sampler,
+    pipelines: HashMap<SharedString, Option<wgpu::RenderPipeline>>,
+    uniforms: Option<wgpu::Buffer>,
+    stride: u64,
+    backdrop: Option<(wgpu::Texture, wgpu::TextureView)>,
+    empty: wgpu::TextureView,
+    target_size: (u32, u32),
+    backdrop_readable: bool,
+}
+
+impl WgpuShaders {
+    pub(crate) fn new(
+        device: Arc<wgpu::Device>,
+        queue: Arc<wgpu::Queue>,
+        format: wgpu::TextureFormat,
+    ) -> Self {
+        let bind_group_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("paint_shader_layout"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: true,
+                        min_binding_size: wgpu::BufferSize::new(UNIFORM_SIZE),
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+            ],
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("paint_shader_pipeline_layout"),
+            bind_group_layouts: &[Some(&bind_group_layout)],
+            immediate_size: 0,
+        });
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("paint_shader_sampler"),
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            ..Default::default()
+        });
+        let empty = device
+            .create_texture(&wgpu::TextureDescriptor {
+                label: Some("paint_shader_empty"),
+                size: wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING,
+                view_formats: &[],
+            })
+            .create_view(&wgpu::TextureViewDescriptor::default());
+        let alignment = u64::from(device.limits().min_uniform_buffer_offset_alignment);
+        Self {
+            device,
+            queue,
+            format,
+            bind_group_layout,
+            pipeline_layout,
+            sampler,
+            pipelines: HashMap::default(),
+            uniforms: None,
+            stride: UNIFORM_SIZE.next_multiple_of(alignment),
+            backdrop: None,
+            empty,
+            target_size: (0, 0),
+            backdrop_readable: false,
+        }
+    }
+
+    fn compile(&self, source: &str) -> Result<wgpu::RenderPipeline> {
+        let wgsl = format!("{SHADER_PRELUDE}\n{source}");
+        let module =
+            naga::front::wgsl::parse_str(&wgsl).map_err(|error| anyhow!(error.emit_to_string(&wgsl)))?;
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::empty(),
+        )
+        .validate(&module)
+        .map_err(|error| anyhow!(error.emit_to_string(&wgsl)))?;
+        let module = self.device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("paint_shader"),
+            source: wgpu::ShaderSource::Wgsl(wgsl.into()),
+        });
+        Ok(self.device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("paint_shader"),
+            layout: Some(&self.pipeline_layout),
+            vertex: wgpu::VertexState {
+                module: &module,
+                entry_point: Some("gpui_shader_vertex"),
+                buffers: &[],
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+            },
+            fragment: Some(wgpu::FragmentState {
+                module: &module,
+                entry_point: Some("gpui_shader_fragment"),
+                targets: &[Some(wgpu::ColorTargetState {
+                    format: self.format,
+                    blend: Some(wgpu::BlendState::PREMULTIPLIED_ALPHA_BLENDING),
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+            }),
+            primitive: wgpu::PrimitiveState::default(),
+            depth_stencil: None,
+            multisample: wgpu::MultisampleState::default(),
+            multiview_mask: None,
+            cache: None,
+        }))
+    }
+
+    pub(crate) fn prepare(&mut self, scene: &Scene, target: &wgpu::Texture) {
+        if scene.shaders.is_empty() {
+            return;
+        }
+        self.target_size = (target.width(), target.height());
+        let readable = target.usage().contains(wgpu::TextureUsages::COPY_SRC);
+        if !readable && self.backdrop_readable {
+            log::warn!("paint_shader skips shaders that read a backdrop: this surface forbids copies");
+        }
+        self.backdrop_readable = readable;
+        for shader in &scene.shaders {
+            if self.pipelines.contains_key(&shader.source) {
+                continue;
+            }
+            if self.pipelines.len() >= MAX_PIPELINES {
+                self.pipelines.clear();
+            }
+            let pipeline = self
+                .compile(&shader.source)
+                .inspect_err(|error| log::error!("paint_shader failed to compile: {error:#}"))
+                .ok();
+            self.pipelines.insert(shader.source.clone(), pipeline);
+        }
+        let needed = self.stride * scene.shaders.len() as u64;
+        if self.uniforms.as_ref().is_none_or(|buffer| buffer.size() < needed) {
+            self.uniforms = Some(self.device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("paint_shader_uniforms"),
+                size: needed.next_power_of_two(),
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            }));
+        }
+        let Some(uniforms) = self.uniforms.as_ref() else { return };
+        for (index, shader) in scene.shaders.iter().enumerate() {
+            let frame = ShaderFrame {
+                bounds: [
+                    shader.bounds.origin.x.0,
+                    shader.bounds.origin.y.0,
+                    shader.bounds.size.width.0,
+                    shader.bounds.size.height.0,
+                ],
+                viewport: [target.width() as f32, target.height() as f32],
+                scale: shader.scale,
+                time: shader.time,
+                params: shader.params,
+            };
+            self.queue.write_buffer(uniforms, self.stride * index as u64, bytemuck::bytes_of(&frame));
+        }
+        let wants_backdrop = readable && scene.shaders.iter().any(|shader| shader.reads_backdrop);
+        let stale = self.backdrop.as_ref().is_none_or(|(texture, _)| {
+            texture.width() != target.width()
+                || texture.height() != target.height()
+                || texture.format() != target.format()
+        });
+        if wants_backdrop && stale {
+            let texture = self.device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("paint_shader_backdrop"),
+                size: target.size(),
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: target.format(),
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+            let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+            self.backdrop = Some((texture, view));
+        }
+    }
+
+    pub(crate) fn copy_backdrop(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::Texture,
+        shader: &PaintShader,
+    ) {
+        if !self.backdrop_readable {
+            return;
+        }
+        let Some((backdrop, _)) = self.backdrop.as_ref() else { return };
+        let Some(clip) = clip_of(shader, target.width(), target.height()) else { return };
+        let origin = wgpu::Origin3d { x: clip.x, y: clip.y, z: 0 };
+        encoder.copy_texture_to_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture: target,
+                mip_level: 0,
+                origin,
+                aspect: wgpu::TextureAspect::All,
+            },
+            wgpu::TexelCopyTextureInfo {
+                texture: backdrop,
+                mip_level: 0,
+                origin,
+                aspect: wgpu::TextureAspect::All,
+            },
+            wgpu::Extent3d { width: clip.width, height: clip.height, depth_or_array_layers: 1 },
+        );
+    }
+
+    pub(crate) fn draw(&self, index: usize, shader: &PaintShader, pass: &mut wgpu::RenderPass<'_>) {
+        if shader.reads_backdrop && !self.backdrop_readable {
+            return;
+        }
+        let (width, height) = self.target_size;
+        let Some(clip) = clip_of(shader, width, height) else { return };
+        let Some(Some(pipeline)) = self.pipelines.get(&shader.source) else { return };
+        let Some(uniforms) = self.uniforms.as_ref() else { return };
+        let backdrop = self
+            .backdrop
+            .as_ref()
+            .filter(|_| shader.reads_backdrop)
+            .map_or(&self.empty, |(_, view)| view);
+        let bind_group = self.device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("paint_shader_bind_group"),
+            layout: &self.bind_group_layout,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                        buffer: uniforms,
+                        offset: 0,
+                        size: wgpu::BufferSize::new(UNIFORM_SIZE),
+                    }),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::TextureView(backdrop),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: wgpu::BindingResource::Sampler(&self.sampler),
+                },
+            ],
+        });
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &bind_group, &[(self.stride * index as u64) as u32]);
+        pass.set_scissor_rect(clip.x, clip.y, clip.width, clip.height);
+        pass.draw(0..6, 0..1);
+        pass.set_scissor_rect(0, 0, width, height);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::{WgpuContext, WgpuRenderer};
+    use gpui::{
+        Background, Bounds, ContentMask, DevicePixels, PaintShader, Quad, ScaledPixels, Scene,
+        SharedString, Size, point, px, rgb, size,
+    };
+
+    const SIDE: i32 = 40;
+
+    fn area(x: f32, width: f32) -> Bounds<ScaledPixels> {
+        Bounds {
+            origin: point(px(x).scale(1.0), px(0.0).scale(1.0)),
+            size: size(px(width).scale(1.0), px(SIDE as f32).scale(1.0)),
+        }
+    }
+
+    fn mask() -> ContentMask<ScaledPixels> {
+        ContentMask { bounds: area(0.0, SIDE as f32) }
+    }
+
+    fn quad(x: f32, width: f32, color: u32) -> Quad {
+        Quad {
+            bounds: area(x, width),
+            content_mask: mask(),
+            background: Background::from(rgb(color)),
+            ..Default::default()
+        }
+    }
+
+    fn shader(source: &str, reads_backdrop: bool) -> PaintShader {
+        PaintShader {
+            order: 0,
+            bounds: area(0.0, SIDE as f32),
+            content_mask: mask(),
+            source: SharedString::from(source.to_string()),
+            scale: 1.0,
+            time: 0.0,
+            params: [[0.0; 4]; 8],
+            reads_backdrop,
+        }
+    }
+
+    fn render(scene: &mut Scene) -> Vec<u8> {
+        scene.finish();
+        let context = WgpuContext::new_offscreen().expect("an adapter");
+        let extent = Size { width: DevicePixels(SIDE), height: DevicePixels(SIDE) };
+        let mut renderer = WgpuRenderer::new_offscreen(&context, extent).expect("a renderer");
+        let mut pixels = vec![0; (SIDE * SIDE * 4) as usize];
+        renderer.render_to_pixels(scene, extent, &mut pixels).expect("renders");
+        pixels
+    }
+
+    fn at(pixels: &[u8], x: usize, y: usize) -> [u8; 3] {
+        let offset = (y * SIDE as usize + x) * 4;
+        [pixels[offset], pixels[offset + 1], pixels[offset + 2]]
+    }
+
+    fn layered(scene: &mut Scene, primitive: impl Into<gpui::Primitive>) {
+        scene.push_layer(area(0.0, SIDE as f32));
+        scene.insert_primitive(primitive);
+        scene.pop_layer();
+    }
+
+    #[test]
+    fn a_shader_keeps_its_place_in_painter_order() {
+        let mut scene = Scene::default();
+        layered(&mut scene, quad(0.0, 40.0, 0xff0000));
+        layered(&mut scene, shader("fn shade(p: vec2f) -> vec4f { return vec4f(0., 1., 0., 1.); }", false));
+        layered(&mut scene, quad(20.0, 20.0, 0x0000ff));
+        let pixels = render(&mut scene);
+        assert_eq!(at(&pixels, 10, 20), [0, 255, 0]);
+        assert_eq!(at(&pixels, 30, 20), [0, 0, 255]);
+    }
+
+    #[test]
+    fn two_shaders_keep_their_own_uniforms() {
+        let source = "fn shade(p: vec2f) -> vec4f { return vec4f(frame.params[0].rgb, 1.); }";
+        let mut left = shader(source, false);
+        left.bounds = area(0.0, 20.0);
+        left.params[0] = [1.0, 0.0, 0.0, 0.0];
+        let mut right = shader(source, false);
+        right.bounds = area(20.0, 20.0);
+        right.params[0] = [0.0, 0.0, 1.0, 0.0];
+        let mut scene = Scene::default();
+        layered(&mut scene, left);
+        layered(&mut scene, right);
+        let pixels = render(&mut scene);
+        assert_eq!(at(&pixels, 10, 20), [255, 0, 0]);
+        assert_eq!(at(&pixels, 30, 20), [0, 0, 255]);
+    }
+
+    #[test]
+    fn a_shader_reads_what_was_drawn_before_it() {
+        let mut scene = Scene::default();
+        layered(&mut scene, quad(0.0, 40.0, 0xff0000));
+        layered(&mut scene, shader("fn shade(p: vec2f) -> vec4f { return vec4f(backdrop_at(vec2f(10., 10.)).bgr, 1.); }", true));
+        assert_eq!(at(&render(&mut scene), 20, 20), [0, 0, 255]);
+    }
+
+    #[test]
+    fn a_shader_that_does_not_compile_draws_nothing_and_keeps_the_frame() {
+        let mut scene = Scene::default();
+        layered(&mut scene, quad(0.0, 40.0, 0xff0000));
+        layered(&mut scene, shader("fn shade(", false));
+        assert_eq!(at(&render(&mut scene), 20, 20), [255, 0, 0]);
+    }
+}
