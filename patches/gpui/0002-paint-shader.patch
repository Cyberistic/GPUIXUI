+@group(0) @binding(3) var s_out: texture_storage_2d<rgba16float, write>;
+@group(0) @binding(4) var a_in: texture_2d<f32>;
+@group(0) @binding(5) var b_in: texture_2d<f32>;
+@group(0) @binding(6) var r_out: texture_storage_2d<r32float, write>;
+fn pass_state(id: vec3u) { textureStore(s_out, vec2i(id.xy), textureLoad(s_in, vec2i(id.xy), 0)); }
+fn pass_scalar(id: vec3u) { textureStore(r_out, vec2i(id.xy), textureLoad(a_in, vec2i(id.xy), 0) + textureLoad(b_in, vec2i(id.xy), 0)); }
+@compute @workgroup_size(8, 8) fn curl(@builtin(global_invocation_id) id: vec3u) { pass_scalar(id); }
+@compute @workgroup_size(8, 8) fn forces(@builtin(global_invocation_id) id: vec3u) { pass_state(id); }
+@compute @workgroup_size(8, 8) fn divergence(@builtin(global_invocation_id) id: vec3u) { pass_scalar(id); }
+@compute @workgroup_size(8, 8) fn jacobi(@builtin(global_invocation_id) id: vec3u) { pass_scalar(id); }
+@compute @workgroup_size(8, 8) fn project(@builtin(global_invocation_id) id: vec3u) { pass_state(id); }
+@compute @workgroup_size(8, 8) fn advect(@builtin(global_invocation_id) id: vec3u) {
+    let previous = select(textureLoad(s_in, vec2i(id.xy), 0).x, 0.0, u[1].w > 0.5);
+    textureStore(s_out, vec2i(id.xy), vec4f(previous + 1.0 / 255.0, 0.0, 0.0, 1.0));
