+#[cfg(test)]
+mod shader_tests {
+    use super::*;
+    use crate::{point, px, size};
+
+    fn area() -> Bounds<ScaledPixels> {
+        Bounds {
+            origin: point(px(0.0).scale(1.0), px(0.0).scale(1.0)),
+            size: size(px(10.0).scale(1.0), px(10.0).scale(1.0)),
+        }
+    }
+
+    fn shader() -> PaintShader {
+        PaintShader {
+            order: 0,
+            bounds: area(),
+            content_mask: ContentMask { bounds: area() },
+            source: "fn shade(p: vec2f) -> vec4f { return vec4f(0.); }".into(),
+            scale: 1.0,
+            time: 0.0,
+            params: [[0.0; 4]; SHADER_PARAMS],
+            reads_backdrop: false,
+            simulation: None,
+            data: None,
+        }
+    }
+
+    #[test]
+    fn a_simulation_steps_at_a_fixed_rate_and_warms_up_only_when_it_must() {
+        let (steps, _, reset) = simulation_schedule(None, 3.0);
+        assert!(reset && steps == SIMULATION_WARMUP_STEPS);
+        let (steps, _, reset) = simulation_schedule(Some(1.0), 1.0 + 2.5 * SIMULATION_DT);
+        assert!(!reset && steps == 2);
+        assert_eq!(simulation_schedule(Some(1.0), 3.0).0, SIMULATION_MAX_STEPS);
+        assert_eq!(simulation_schedule(Some(1.0), 1.0).0, 0);
+        assert!(simulation_schedule(Some(2.0), 1.0).2, "back in time starts over");
+    }
+
+    #[test]
+    fn a_step_ends_its_pressure_solve_where_projection_reads_it() {
+        let last_jacobi = simulation_pass_order().filter(|pass| *pass == 3 || *pass == 4).last();
+        let written = SIMULATION_PASSES[last_jacobi.unwrap()].1[4];
+        assert_eq!(written, SIMULATION_PASSES[5].1[2]);
+    }
+
+    // A shader left in the scene is redrawn every later frame and additive light saturates.
+    #[test]
+    fn clearing_a_scene_drops_its_shaders() {
+        let mut scene = Scene::default();
+        scene.insert_primitive(shader());
+        scene.clear();
+        assert!(scene.shaders.is_empty());
+    }
+
+    #[test]
+    fn a_shader_batches_between_the_quads_painted_around_it() {
+        let quad = Quad {
+            bounds: area(),
+            content_mask: ContentMask { bounds: area() },
+            ..Default::default()
+        };
+        let mut scene = Scene::default();
+        scene.insert_primitive(quad);
+        scene.insert_primitive(shader());
+        scene.insert_primitive(quad);
+        scene.finish();
+        let kinds: Vec<String> = scene.batches().map(|batch| batch.label()).collect();
+        assert_eq!(kinds, ["quads (1)", "shaders (1)", "quads (1)"]);
+    }
+}
