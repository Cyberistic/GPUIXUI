diff --git a/crates/gpui_wgpu/src/wgpu_shader.rs b/crates/gpui_wgpu/src/wgpu_shader.rs
new file mode 100644
index 0000000..1889749
--- /dev/null
+++ b/crates/gpui_wgpu/src/wgpu_shader.rs
@@ -0,0 +1,767 @@
+use anyhow::{Result, anyhow};
+use collections::HashMap;
+use gpui::{
+    PaintShader, SHADER_PARAMS, SHADER_PRELUDE, SIMULATION_DT, SIMULATION_PASSES, Scene,
+    ShaderSimulation, SharedString, simulation_pass_order, simulation_schedule,
+};
+use std::sync::Arc;
+
+const MAX_PIPELINES: usize = 64;
+const UNIFORM_SIZE: u64 = 32 + 16 * SHADER_PARAMS as u64;
+const SIMULATION_SLOT: u64 = 256;
+const SIMULATION_SLOTS: u64 = 80;
+
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct ShaderFrame {
+    bounds: [f32; 4],
+    viewport: [f32; 2],
+    scale: f32,
+    time: f32,
+    params: [[f32; 4]; SHADER_PARAMS],
+}
+
+struct Clip {
+    x: u32,
+    y: u32,
+    width: u32,
+    height: u32,
+}
+
+fn clip_of(shader: &PaintShader, width: u32, height: u32) -> Option<Clip> {
+    let visible = shader.bounds.intersect(&shader.content_mask.bounds);
+    let x0 = (visible.origin.x.0.floor().max(0.0) as u32).min(width);
+    let y0 = (visible.origin.y.0.floor().max(0.0) as u32).min(height);
+    let x1 = ((visible.origin.x.0 + visible.size.width.0).ceil().max(0.0) as u32).min(width);
+    let y1 = ((visible.origin.y.0 + visible.size.height.0).ceil().max(0.0) as u32).min(height);
+    (x1 > x0 && y1 > y0).then_some(Clip { x: x0, y: y0, width: x1 - x0, height: y1 - y0 })
+}
+
+pub(crate) struct WgpuShaders {
+    device: Arc<wgpu::Device>,
+    queue: Arc<wgpu::Queue>,
+    format: wgpu::TextureFormat,
+    bind_group_layout: wgpu::BindGroupLayout,
+    pipeline_layout: wgpu::PipelineLayout,
+    sampler: wgpu::Sampler,
+    pipelines: HashMap<SharedString, Option<wgpu::RenderPipeline>>,
+    uniforms: Option<wgpu::Buffer>,
+    stride: u64,
+    backdrop: Option<(wgpu::Texture, wgpu::TextureView)>,
+    empty: wgpu::TextureView,
+    empty_data: wgpu::TextureView,
+    tables: Vec<Option<wgpu::TextureView>>,
+    target_size: (u32, u32),
+    backdrop_readable: bool,
+    compute: Option<(wgpu::BindGroupLayout, wgpu::PipelineLayout)>,
+    programs: HashMap<SharedString, Option<HashMap<&'static str, wgpu::ComputePipeline>>>,
+    grids: HashMap<u64, Grid>,
+    frame: u64,
+}
+
+struct Grid {
+    size: [u32; 2],
+    views: Vec<wgpu::TextureView>,
+    uniforms: wgpu::Buffer,
+    current: usize,
+    time: Option<f32>,
+    used: u64,
+}
+
+impl WgpuShaders {
+    pub(crate) fn new(
+        device: Arc<wgpu::Device>,
+        queue: Arc<wgpu::Queue>,
+        format: wgpu::TextureFormat,
+    ) -> Self {
+        let bind_group_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("paint_shader_layout"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: true,
+                        min_binding_size: wgpu::BufferSize::new(UNIFORM_SIZE),
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 4,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: false },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 3,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Texture {
+                        sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                        view_dimension: wgpu::TextureViewDimension::D2,
+                        multisampled: false,
+                    },
+                    count: None,
+                },
+            ],
+        });
+        let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("paint_shader_pipeline_layout"),
+            bind_group_layouts: &[Some(&bind_group_layout)],
+            immediate_size: 0,
+        });
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("paint_shader_sampler"),
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            ..Default::default()
+        });
+        let empty = device
+            .create_texture(&wgpu::TextureDescriptor {
+                label: Some("paint_shader_empty"),
+                size: wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING,
+                view_formats: &[],
+            })
+            .create_view(&wgpu::TextureViewDescriptor::default());
+        let empty_data = device
+            .create_texture(&wgpu::TextureDescriptor {
+                label: Some("paint_shader_empty_data"),
+                size: wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Rgba32Float,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING,
+                view_formats: &[],
+            })
+            .create_view(&wgpu::TextureViewDescriptor::default());
+        let alignment = u64::from(device.limits().min_uniform_buffer_offset_alignment);
+        let read = wgpu::BindingType::Texture {
+            sample_type: wgpu::TextureSampleType::Float { filterable: false },
+            view_dimension: wgpu::TextureViewDimension::D2,
+            multisampled: false,
+        };
+        let write = |format| wgpu::BindingType::StorageTexture {
+            access: wgpu::StorageTextureAccess::WriteOnly,
+            format,
+            view_dimension: wgpu::TextureViewDimension::D2,
+        };
+        let entry = |binding, ty| wgpu::BindGroupLayoutEntry {
+            binding,
+            visibility: wgpu::ShaderStages::COMPUTE,
+            ty,
+            count: None,
+        };
+        let compute = (device.limits().max_compute_workgroups_per_dimension > 0).then(|| {
+        let compute_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("paint_shader_simulation_layout"),
+            entries: &[
+                entry(0, wgpu::BindingType::Buffer {
+                    ty: wgpu::BufferBindingType::Uniform,
+                    has_dynamic_offset: true,
+                    min_binding_size: wgpu::BufferSize::new(96),
+                }),
+                entry(1, read),
+                entry(3, write(wgpu::TextureFormat::Rgba16Float)),
+                entry(4, read),
+                entry(5, read),
+                entry(6, write(wgpu::TextureFormat::R32Float)),
+            ],
+        });
+        let compute_pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: Some("paint_shader_simulation_pipeline_layout"),
+            bind_group_layouts: &[Some(&compute_layout)],
+            immediate_size: 0,
+        });
+        (compute_layout, compute_pipeline_layout)
+        });
+        Self {
+            device,
+            queue,
+            format,
+            bind_group_layout,
+            pipeline_layout,
+            sampler,
+            pipelines: HashMap::default(),
+            uniforms: None,
+            stride: UNIFORM_SIZE.next_multiple_of(alignment),
+            backdrop: None,
+            empty,
+            empty_data,
+            tables: Vec::new(),
+            target_size: (0, 0),
+            backdrop_readable: false,
+            compute,
+            programs: HashMap::default(),
+            grids: HashMap::default(),
+            frame: 0,
+        }
+    }
+
+    fn compile(&self, source: &str) -> Result<wgpu::RenderPipeline> {
+        let wgsl = format!("{SHADER_PRELUDE}\n{source}");
+        let module =
+            naga::front::wgsl::parse_str(&wgsl).map_err(|error| anyhow!(error.emit_to_string(&wgsl)))?;
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::empty(),
+        )
+        .validate(&module)
+        .map_err(|error| anyhow!(error.emit_to_string(&wgsl)))?;
+        let module = self.device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("paint_shader"),
+            source: wgpu::ShaderSource::Wgsl(wgsl.into()),
+        });
+        Ok(self.device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some("paint_shader"),
+            layout: Some(&self.pipeline_layout),
+            vertex: wgpu::VertexState {
+                module: &module,
+                entry_point: Some("gpui_shader_vertex"),
+                buffers: &[],
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+            },
+            fragment: Some(wgpu::FragmentState {
+                module: &module,
+                entry_point: Some("gpui_shader_fragment"),
+                targets: &[Some(wgpu::ColorTargetState {
+                    format: self.format,
+                    blend: Some(wgpu::BlendState::PREMULTIPLIED_ALPHA_BLENDING),
+                    write_mask: wgpu::ColorWrites::ALL,
+                })],
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+            }),
+            primitive: wgpu::PrimitiveState::default(),
+            depth_stencil: None,
+            multisample: wgpu::MultisampleState::default(),
+            multiview_mask: None,
+            cache: None,
+        }))
+    }
+
+    fn compile_program(&self, source: &str) -> Result<HashMap<&'static str, wgpu::ComputePipeline>> {
+        let (_, compute_pipeline_layout) =
+            self.compute.as_ref().ok_or_else(|| anyhow!("this device has no compute shaders"))?;
+        let module =
+            naga::front::wgsl::parse_str(source).map_err(|error| anyhow!(error.emit_to_string(source)))?;
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::empty(),
+        )
+        .validate(&module)
+        .map_err(|error| anyhow!(error.emit_to_string(source)))?;
+        let module = self.device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("paint_shader_simulation"),
+            source: wgpu::ShaderSource::Wgsl(source.into()),
+        });
+        let mut pipelines = HashMap::default();
+        for (entry, _) in SIMULATION_PASSES {
+            pipelines.insert(
+                entry,
+                self.device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                    label: Some(entry),
+                    layout: Some(compute_pipeline_layout),
+                    module: &module,
+                    entry_point: Some(entry),
+                    compilation_options: wgpu::PipelineCompilationOptions::default(),
+                    cache: None,
+                }),
+            );
+        }
+        Ok(pipelines)
+    }
+
+    fn new_grid(&self, size: [u32; 2]) -> Grid {
+        let view = |format| {
+            self.device
+                .create_texture(&wgpu::TextureDescriptor {
+                    label: Some("paint_shader_simulation_grid"),
+                    size: wgpu::Extent3d { width: size[0], height: size[1], depth_or_array_layers: 1 },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format,
+                    usage: wgpu::TextureUsages::STORAGE_BINDING | wgpu::TextureUsages::TEXTURE_BINDING,
+                    view_formats: &[],
+                })
+                .create_view(&wgpu::TextureViewDescriptor::default())
+        };
+        let mut views: Vec<_> = (0..2).map(|_| view(wgpu::TextureFormat::Rgba16Float)).collect();
+        views.extend((0..4).map(|_| view(wgpu::TextureFormat::R32Float)));
+        let uniforms = self.device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("paint_shader_simulation_uniforms"),
+            size: SIMULATION_SLOT * SIMULATION_SLOTS,
+            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        });
+        Grid { size, views, uniforms, current: 0, time: None, used: 0 }
+    }
+
+    pub(crate) fn simulate(&mut self, scene: &Scene, encoder: &mut wgpu::CommandEncoder) {
+        self.frame += 1;
+        if self.compute.is_some() {
+            for shader in &scene.shaders {
+                if let Some(simulation) = &shader.simulation {
+                    self.step(simulation, shader.time, encoder);
+                }
+            }
+        }
+        let frame = self.frame;
+        self.grids.retain(|_, grid| grid.used + 1 >= frame);
+    }
+
+    fn step(&mut self, simulation: &ShaderSimulation, time: f32, encoder: &mut wgpu::CommandEncoder) {
+        if !self.programs.contains_key(&simulation.source) {
+            if self.programs.len() >= MAX_PIPELINES {
+                self.programs.clear();
+            }
+            let program = self
+                .compile_program(&simulation.source)
+                .inspect_err(|error| log::error!("paint_shader simulation failed to compile: {error:#}"))
+                .ok();
+            self.programs.insert(simulation.source.clone(), program);
+        }
+        let stale = self.grids.get(&simulation.key).is_none_or(|grid| grid.size != simulation.grid);
+        if stale {
+            let grid = self.new_grid(simulation.grid);
+            self.grids.insert(simulation.key, grid);
+        }
+        let Some((compute_layout, _)) = self.compute.as_ref() else { return };
+        let Some(Some(program)) = self.programs.get(&simulation.source) else { return };
+        let Some(grid) = self.grids.get_mut(&simulation.key) else { return };
+        grid.used = self.frame;
+        let (steps, start, reset) = simulation_schedule(grid.time, time);
+        if steps == 0 {
+            return;
+        }
+        for step in 0..steps {
+            let mut uniform = simulation.uniform;
+            uniform[1][2] = start + (step + 1) as f32 * SIMULATION_DT;
+            uniform[1][3] = if reset && step == 0 { 1.0 } else { 0.0 };
+            self.queue.write_buffer(
+                &grid.uniforms,
+                step as u64 * SIMULATION_SLOT,
+                bytemuck::cast_slice(&uniform),
+            );
+        }
+        let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+            label: Some("paint_shader_simulation"),
+            timestamp_writes: None,
+        });
+        let groups = [grid.size[0].div_ceil(8), grid.size[1].div_ceil(8)];
+        for step in 0..steps {
+            for index in simulation_pass_order() {
+                let (entry, bindings) = SIMULATION_PASSES[index];
+                let view = |slot: usize| {
+                    let binding = bindings[slot];
+                    let texture = if binding < 2 { binding ^ grid.current } else { binding };
+                    wgpu::BindingResource::TextureView(&grid.views[texture])
+                };
+                let bind_group = self.device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("paint_shader_simulation"),
+                    layout: compute_layout,
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                                buffer: &grid.uniforms,
+                                offset: 0,
+                                size: wgpu::BufferSize::new(96),
+                            }),
+                        },
+                        wgpu::BindGroupEntry { binding: 1, resource: view(0) },
+                        wgpu::BindGroupEntry { binding: 3, resource: view(1) },
+                        wgpu::BindGroupEntry { binding: 4, resource: view(2) },
+                        wgpu::BindGroupEntry { binding: 5, resource: view(3) },
+                        wgpu::BindGroupEntry { binding: 6, resource: view(4) },
+                    ],
+                });
+                pass.set_pipeline(&program[entry]);
+                pass.set_bind_group(0, &bind_group, &[(step as u64 * SIMULATION_SLOT) as u32]);
+                pass.dispatch_workgroups(groups[0], groups[1], 1);
+            }
+            grid.current ^= 1;
+        }
+        drop(pass);
+        grid.time = Some(start + steps as f32 * SIMULATION_DT);
+    }
+
+    pub(crate) fn prepare(&mut self, scene: &Scene, target: &wgpu::Texture) {
+        if scene.shaders.is_empty() {
+            return;
+        }
+        self.target_size = (target.width(), target.height());
+        let readable = target.usage().contains(wgpu::TextureUsages::COPY_SRC);
+        if !readable && self.backdrop_readable {
+            log::warn!("paint_shader skips shaders that read a backdrop: this surface forbids copies");
+        }
+        self.backdrop_readable = readable;
+        for shader in &scene.shaders {
+            if self.pipelines.contains_key(&shader.source) {
+                continue;
+            }
+            if self.pipelines.len() >= MAX_PIPELINES {
+                self.pipelines.clear();
+            }
+            let pipeline = self
+                .compile(&shader.source)
+                .inspect_err(|error| log::error!("paint_shader failed to compile: {error:#}"))
+                .ok();
+            self.pipelines.insert(shader.source.clone(), pipeline);
+        }
+        let needed = self.stride * scene.shaders.len() as u64;
+        if self.uniforms.as_ref().is_none_or(|buffer| buffer.size() < needed) {
+            self.uniforms = Some(self.device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("paint_shader_uniforms"),
+                size: needed.next_power_of_two(),
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            }));
+        }
+        self.tables = scene
+            .shaders
+            .iter()
+            .map(|shader| {
+                let data = shader.data.as_ref()?;
+                let height = data.len().div_ceil(1024).max(1) as u32;
+                let extent = wgpu::Extent3d { width: 1024, height, depth_or_array_layers: 1 };
+                let texture = self.device.create_texture(&wgpu::TextureDescriptor {
+                    label: Some("paint_shader_data"),
+                    size: extent,
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: wgpu::TextureFormat::Rgba32Float,
+                    usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                    view_formats: &[],
+                });
+                let mut rows = data.to_vec();
+                rows.resize(1024 * height as usize, [0.0; 4]);
+                self.queue.write_texture(
+                    wgpu::TexelCopyTextureInfo {
+                        texture: &texture,
+                        mip_level: 0,
+                        origin: wgpu::Origin3d::ZERO,
+                        aspect: wgpu::TextureAspect::All,
+                    },
+                    bytemuck::cast_slice(&rows),
+                    wgpu::TexelCopyBufferLayout {
+                        offset: 0,
+                        bytes_per_row: Some(1024 * 16),
+                        rows_per_image: Some(height),
+                    },
+                    extent,
+                );
+                Some(texture.create_view(&wgpu::TextureViewDescriptor::default()))
+            })
+            .collect();
+        let Some(uniforms) = self.uniforms.as_ref() else { return };
+        for (index, shader) in scene.shaders.iter().enumerate() {
+            let frame = ShaderFrame {
+                bounds: [
+                    shader.bounds.origin.x.0,
+                    shader.bounds.origin.y.0,
+                    shader.bounds.size.width.0,
+                    shader.bounds.size.height.0,
+                ],
+                viewport: [target.width() as f32, target.height() as f32],
+                scale: shader.scale,
+                time: shader.time,
+                params: shader.params,
+            };
+            self.queue.write_buffer(uniforms, self.stride * index as u64, bytemuck::bytes_of(&frame));
+        }
+        let wants_backdrop = readable && scene.shaders.iter().any(|shader| shader.reads_backdrop);
+        let stale = self.backdrop.as_ref().is_none_or(|(texture, _)| {
+            texture.width() != target.width()
+                || texture.height() != target.height()
+                || texture.format() != target.format()
+        });
+        if wants_backdrop && stale {
+            let texture = self.device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("paint_shader_backdrop"),
+                size: target.size(),
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: target.format(),
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+            let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+            self.backdrop = Some((texture, view));
+        }
+    }
+
+    pub(crate) fn copy_backdrop(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        target: &wgpu::Texture,
+        shader: &PaintShader,
+    ) {
+        if !self.backdrop_readable {
+            return;
+        }
+        let Some((backdrop, _)) = self.backdrop.as_ref() else { return };
+        if clip_of(shader, target.width(), target.height()).is_none() {
+            return;
+        }
+        encoder.copy_texture_to_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture: target,
+                mip_level: 0,
+                origin: wgpu::Origin3d::ZERO,
+                aspect: wgpu::TextureAspect::All,
+            },
+            wgpu::TexelCopyTextureInfo {
+                texture: backdrop,
+                mip_level: 0,
+                origin: wgpu::Origin3d::ZERO,
+                aspect: wgpu::TextureAspect::All,
+            },
+            target.size(),
+        );
+    }
+
+    pub(crate) fn draw(&self, index: usize, shader: &PaintShader, pass: &mut wgpu::RenderPass<'_>) {
+        if shader.reads_backdrop && !self.backdrop_readable {
+            return;
+        }
+        let (width, height) = self.target_size;
+        let Some(clip) = clip_of(shader, width, height) else { return };
+        let Some(Some(pipeline)) = self.pipelines.get(&shader.source) else { return };
+        let Some(uniforms) = self.uniforms.as_ref() else { return };
+        let backdrop = self
+            .backdrop
+            .as_ref()
+            .filter(|_| shader.reads_backdrop)
+            .map_or(&self.empty, |(_, view)| view);
+        let state = shader
+            .simulation
+            .as_ref()
+            .and_then(|simulation| self.grids.get(&simulation.key))
+            .map_or(&self.empty, |grid| &grid.views[grid.current]);
+        let bind_group = self.device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("paint_shader_bind_group"),
+            layout: &self.bind_group_layout,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                        buffer: uniforms,
+                        offset: 0,
+                        size: wgpu::BufferSize::new(UNIFORM_SIZE),
+                    }),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::TextureView(backdrop),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: wgpu::BindingResource::Sampler(&self.sampler),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 3,
+                    resource: wgpu::BindingResource::TextureView(state),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 4,
+                    resource: wgpu::BindingResource::TextureView(
+                        self.tables.get(index).and_then(Option::as_ref).unwrap_or(&self.empty_data),
+                    ),
+                },
+            ],
+        });
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &bind_group, &[(self.stride * index as u64) as u32]);
+        pass.set_scissor_rect(clip.x, clip.y, clip.width, clip.height);
+        pass.draw(0..6, 0..1);
+        pass.set_scissor_rect(0, 0, width, height);
+    }
+}
