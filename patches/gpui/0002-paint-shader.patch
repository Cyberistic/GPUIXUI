new file mode 100644
index 0000000..8c4284c
--- /dev/null
+++ b/crates/gpui_apple/src/metal_shader.rs
@@ -0,0 +1,601 @@
+use anyhow::{Context as _, Result, anyhow};
+use collections::HashMap;
+use gpui::{
+    Bounds, DevicePixels, PaintShader, SHADER_PARAMS, SHADER_PRELUDE, SIMULATION_DT,
+    SIMULATION_PASSES, ScaledPixels, Scene, ShaderSimulation, SharedString, Size,
+    simulation_pass_order, simulation_schedule,
+};
+use metal::MTLPixelFormat;
+use naga::{ResourceBinding, back::msl};
+use std::ffi::c_void;
+
+
+const MAX_PIPELINES: usize = 64;
+
+#[repr(C)]
+struct ShaderFrame {
+    bounds: [f32; 4],
+    viewport: [f32; 2],
+    scale: f32,
+    time: f32,
+    params: [[f32; 4]; SHADER_PARAMS],
+}
+
+pub(crate) struct MetalShaders {
+    device: metal::Device,
+    pixel_format: MTLPixelFormat,
+    pipelines: HashMap<SharedString, Option<metal::RenderPipelineState>>,
+    sampler: metal::SamplerState,
+    backdrop: Option<metal::Texture>,
+    empty: metal::Texture,
+    empty_data: metal::Texture,
+    programs: HashMap<SharedString, Option<HashMap<&'static str, metal::ComputePipelineState>>>,
+    grids: HashMap<u64, Grid>,
+    frame: u64,
+}
+
+struct Grid {
+    size: [u32; 2],
+    textures: Vec<metal::Texture>,
+    current: usize,
+    time: Option<f32>,
+    used: u64,
+}
+
+fn new_grid(device: &metal::Device, size: [u32; 2], used: u64) -> Grid {
+    let texture = |format| {
+        let descriptor = metal::TextureDescriptor::new();
+        descriptor.set_width(size[0] as u64);
+        descriptor.set_height(size[1] as u64);
+        descriptor.set_pixel_format(format);
+        descriptor.set_storage_mode(metal::MTLStorageMode::Private);
+        descriptor.set_usage(metal::MTLTextureUsage::ShaderRead | metal::MTLTextureUsage::ShaderWrite);
+        device.new_texture(&descriptor)
+    };
+    let mut textures: Vec<_> = (0..2).map(|_| texture(MTLPixelFormat::RGBA16Float)).collect();
+    textures.extend((0..4).map(|_| texture(MTLPixelFormat::R32Float)));
+    Grid { size, textures, current: 0, time: None, used }
+}
+
+fn compile_program(
+    device: &metal::Device,
+    source: &str,
+) -> Result<HashMap<&'static str, metal::ComputePipelineState>> {
+    let module = naga::front::wgsl::parse_str(source).map_err(|error| anyhow!(error.emit_to_string(source)))?;
+    let info = naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::default(),
+    )
+    .validate(&module)
+    .map_err(|error| anyhow!(error.emit_to_string(source)))?;
+    let resource = |binding| ResourceBinding { group: 0, binding };
+    let mut resources = msl::BindingMap::default();
+    resources.insert(resource(0), msl::BindTarget { buffer: Some(0), ..Default::default() });
+    for (binding, slot, mutable) in [(1, 0, false), (3, 1, true), (4, 2, false), (5, 3, false), (6, 4, true)] {
+        resources.insert(resource(binding), msl::BindTarget { texture: Some(slot), mutable, ..Default::default() });
+    }
+    let mut options = msl::Options { lang_version: (2, 4), ..Default::default() };
+    for (entry, _) in SIMULATION_PASSES {
+        options.per_entry_point_map.insert(
+            entry.to_string(),
+            msl::EntryPointResources { resources: resources.clone(), ..Default::default() },
+        );
+    }
+    let (code, translation) = msl::write_string(&module, &info, &options, &msl::PipelineOptions::default())?;
+    let library = device
+        .new_library_with_source(&code, &metal::CompileOptions::new())
+        .map_err(|error| anyhow!(error))?;
+    let mut pipelines = HashMap::default();
+    for (entry, _) in SIMULATION_PASSES {
+        let index = module
+            .entry_points
+            .iter()
+            .position(|point| point.name == entry)
+            .with_context(|| format!("no compute entry point `{entry}`"))?;
+        let name = translation.entry_point_names[index].clone().map_err(|error| anyhow!("{error}"))?;
+        let function = library.get_function(&name, None).map_err(|error| anyhow!(error))?;
+        let pipeline = device
+            .new_compute_pipeline_state_with_function(&function)
+            .map_err(|error| anyhow!(error))?;
+        pipelines.insert(entry, pipeline);
+    }
+    Ok(pipelines)
+}
+
+fn binding_map() -> msl::EntryPointResources {
+    let resource = |binding| ResourceBinding { group: 0, binding };
+    let mut resources = msl::BindingMap::default();
+    resources.insert(resource(0), msl::BindTarget { buffer: Some(0), ..Default::default() });
+    resources.insert(resource(1), msl::BindTarget { texture: Some(0), ..Default::default() });
+    resources.insert(
+        resource(2),
+        msl::BindTarget { sampler: Some(msl::BindSamplerTarget::Resource(0)), ..Default::default() },
+    );
+    resources.insert(resource(3), msl::BindTarget { texture: Some(1), ..Default::default() });
+    resources.insert(resource(4), msl::BindTarget { texture: Some(2), ..Default::default() });
+    msl::EntryPointResources { resources, ..Default::default() }
+}
+
+fn compile(
+    device: &metal::Device,
+    pixel_format: MTLPixelFormat,
+    source: &str,
+) -> Result<metal::RenderPipelineState> {
+    let wgsl = format!("{SHADER_PRELUDE}\n{source}");
+    let module = naga::front::wgsl::parse_str(&wgsl).map_err(|error| anyhow!(error.emit_to_string(&wgsl)))?;
+    let info = naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::default(),
+    )
+    .validate(&module)
+    .map_err(|error| anyhow!(error.emit_to_string(&wgsl)))?;
+    let mut options = msl::Options { lang_version: (2, 4), ..Default::default() };
+    for entry in ["gpui_shader_vertex", "gpui_shader_fragment"] {
+        options.per_entry_point_map.insert(entry.to_string(), binding_map());
+    }
+    let (code, translation) = msl::write_string(&module, &info, &options, &msl::PipelineOptions::default())?;
+    let name = |index: usize| -> Result<String> {
+        translation.entry_point_names[index].clone().map_err(|error| anyhow!("{error}"))
+    };
+    let library = device
+        .new_library_with_source(&code, &metal::CompileOptions::new())
+        .map_err(|error| anyhow!(error))?;
+    let vertex = library.get_function(&name(0)?, None).map_err(|error| anyhow!(error))?;
+    let fragment = library.get_function(&name(1)?, None).map_err(|error| anyhow!(error))?;
+    let descriptor = metal::RenderPipelineDescriptor::new();
+    descriptor.set_vertex_function(Some(vertex.as_ref()));
+    descriptor.set_fragment_function(Some(fragment.as_ref()));
+    let attachment = descriptor.color_attachments().object_at(0).context("no attachment")?;
+    attachment.set_pixel_format(pixel_format);
+    attachment.set_blending_enabled(true);
+    attachment.set_rgb_blend_operation(metal::MTLBlendOperation::Add);
+    attachment.set_alpha_blend_operation(metal::MTLBlendOperation::Add);
+    attachment.set_source_rgb_blend_factor(metal::MTLBlendFactor::One);
+    attachment.set_source_alpha_blend_factor(metal::MTLBlendFactor::One);
+    attachment.set_destination_rgb_blend_factor(metal::MTLBlendFactor::OneMinusSourceAlpha);
+    attachment.set_destination_alpha_blend_factor(metal::MTLBlendFactor::OneMinusSourceAlpha);
+    device.new_render_pipeline_state(&descriptor).map_err(|error| anyhow!(error))
+}
+
+fn clipped(shader: &PaintShader, viewport: Size<DevicePixels>) -> Option<metal::MTLRegion> {
+    let visible: Bounds<ScaledPixels> = shader.bounds.intersect(&shader.content_mask.bounds);
+    let (width, height) = (i32::from(viewport.width) as f64, i32::from(viewport.height) as f64);
+    let x0 = (visible.origin.x.0 as f64).floor().clamp(0., width);
+    let y0 = (visible.origin.y.0 as f64).floor().clamp(0., height);
+    let x1 = ((visible.origin.x.0 + visible.size.width.0) as f64).ceil().clamp(0., width);
+    let y1 = ((visible.origin.y.0 + visible.size.height.0) as f64).ceil().clamp(0., height);
+    (x1 > x0 && y1 > y0).then(|| metal::MTLRegion {
+        origin: metal::MTLOrigin { x: x0 as u64, y: y0 as u64, z: 0 },
+        size: metal::MTLSize { width: (x1 - x0) as u64, height: (y1 - y0) as u64, depth: 1 },
+    })
+}
+
+impl MetalShaders {
+    pub(crate) fn new(device: &metal::Device, pixel_format: MTLPixelFormat) -> Self {
+        let sampler = metal::SamplerDescriptor::new();
+        sampler.set_min_filter(metal::MTLSamplerMinMagFilter::Linear);
+        sampler.set_mag_filter(metal::MTLSamplerMinMagFilter::Linear);
+        sampler.set_address_mode_s(metal::MTLSamplerAddressMode::ClampToEdge);
+        sampler.set_address_mode_t(metal::MTLSamplerAddressMode::ClampToEdge);
+        let empty = metal::TextureDescriptor::new();
+        empty.set_width(1);
+        empty.set_height(1);
+        empty.set_pixel_format(pixel_format);
+        Self {
+            device: device.clone(),
+            pixel_format,
+            pipelines: HashMap::default(),
+            sampler: device.new_sampler(&sampler),
+            backdrop: None,
+            empty: device.new_texture(&empty),
+            empty_data: {
+                let descriptor = metal::TextureDescriptor::new();
+                descriptor.set_width(1);
+                descriptor.set_height(1);
+                descriptor.set_pixel_format(MTLPixelFormat::RGBA32Float);
+                device.new_texture(&descriptor)
+            },
+            programs: HashMap::default(),
+            grids: HashMap::default(),
+            frame: 0,
+        }
+    }
+
+    pub(crate) fn simulate(&mut self, scene: &Scene, command_buffer: &metal::CommandBufferRef) {
+        self.frame += 1;
+        for shader in &scene.shaders {
+            if let Some(simulation) = &shader.simulation {
+                self.step(simulation, shader.time, command_buffer);
+            }
+        }
+        let frame = self.frame;
+        self.grids.retain(|_, grid| grid.used + 1 >= frame);
+    }
+
+    fn step(
+        &mut self,
+        simulation: &ShaderSimulation,
+        time: f32,
+        command_buffer: &metal::CommandBufferRef,
+    ) {
+        let device = &self.device;
+        if self.programs.len() >= MAX_PIPELINES && !self.programs.contains_key(&simulation.source) {
+            self.programs.clear();
+        }
+        let program = self.programs.entry(simulation.source.clone()).or_insert_with(|| {
+            compile_program(device, &simulation.source)
+                .inspect_err(|error| log::error!("paint_shader simulation failed to compile: {error:#}"))
+                .ok()
+        });
+        let Some(program) = program.as_ref() else { return };
+        let frame = self.frame;
+        let grid = self
+            .grids
+            .entry(simulation.key)
+            .or_insert_with(|| new_grid(device, simulation.grid, frame));
+        if grid.size != simulation.grid {
+            *grid = new_grid(device, simulation.grid, frame);
+        }
+        grid.used = frame;
+        let (steps, start, reset) = simulation_schedule(grid.time, time);
+        if steps == 0 {
+            return;
+        }
+        let groups = metal::MTLSize {
+            width: grid.size[0].div_ceil(8) as u64,
+            height: grid.size[1].div_ceil(8) as u64,
+            depth: 1,
+        };
+        let group_size = metal::MTLSize { width: 8, height: 8, depth: 1 };
+        let encoder = command_buffer.new_compute_command_encoder();
+        for step in 0..steps {
+            let mut uniform = simulation.uniform;
+            uniform[1][2] = start + (step + 1) as f32 * SIMULATION_DT;
+            uniform[1][3] = if reset && step == 0 { 1.0 } else { 0.0 };
+            encoder.set_bytes(
+                0,
+                std::mem::size_of_val(&uniform) as u64,
+                uniform.as_ptr() as *const c_void,
+            );
+            for pass in simulation_pass_order() {
+                let (entry, bindings) = SIMULATION_PASSES[pass];
+                encoder.set_compute_pipeline_state(&program[entry]);
+                for (slot, binding) in bindings.into_iter().enumerate() {
+                    let index = if binding < 2 { binding ^ grid.current } else { binding };
+                    encoder.set_texture(slot as u64, Some(&grid.textures[index]));
+                }
+                encoder.dispatch_thread_groups(groups, group_size);
+            }
+            grid.current ^= 1;
+        }
+        encoder.end_encoding();
+        grid.time = Some(start + steps as f32 * SIMULATION_DT);
+    }
+
+    pub(crate) fn copy_backdrop(
+        &mut self,
+        command_buffer: &metal::CommandBufferRef,
+        target: &metal::TextureRef,
+        shader: &PaintShader,
+        viewport: Size<DevicePixels>,
+    ) {
+        if clipped(shader, viewport).is_none() {
+            return;
+        }
+        let stale = self.backdrop.as_ref().is_none_or(|texture| {
+            texture.width() != target.width() || texture.height() != target.height()
+        });
+        if stale {
+            let descriptor = metal::TextureDescriptor::new();
+            descriptor.set_width(target.width());
+            descriptor.set_height(target.height());
+            descriptor.set_pixel_format(self.pixel_format);
+            descriptor.set_usage(metal::MTLTextureUsage::ShaderRead);
+            descriptor.set_storage_mode(metal::MTLStorageMode::Private);
+            self.backdrop = Some(self.device.new_texture(&descriptor));
+        }
+        let Some(backdrop) = self.backdrop.as_ref() else { return };
+        let blit = command_buffer.new_blit_command_encoder();
+        let origin = metal::MTLOrigin { x: 0, y: 0, z: 0 };
+        let size = metal::MTLSize { width: target.width(), height: target.height(), depth: 1 };
+        blit.copy_from_texture(target, 0, 0, origin, size, backdrop, 0, 0, origin);
+        blit.end_encoding();
+    }
+
+    pub(crate) fn draw(
+        &mut self,
+        shader: &PaintShader,
+        viewport: Size<DevicePixels>,
+        encoder: &metal::RenderCommandEncoderRef,
+    ) {
+        let Some(region) = clipped(shader, viewport) else { return };
+        if self.pipelines.len() >= MAX_PIPELINES && !self.pipelines.contains_key(&shader.source) {
+            self.pipelines.clear();
+        }
+        let (device, pixel_format) = (&self.device, self.pixel_format);
+        let pipeline = self.pipelines.entry(shader.source.clone()).or_insert_with(|| {
+            compile(device, pixel_format, &shader.source)
+                .inspect_err(|error| log::error!("paint_shader failed to compile: {error:#}"))
+                .ok()
+        });
+        let Some(pipeline) = pipeline.as_ref() else { return };
+        let uniform = ShaderFrame {
+            bounds: [
+                shader.bounds.origin.x.0,
+                shader.bounds.origin.y.0,
+                shader.bounds.size.width.0,
+                shader.bounds.size.height.0,
+            ],
+            viewport: [i32::from(viewport.width) as f32, i32::from(viewport.height) as f32],
+            scale: shader.scale,
+            time: shader.time,
+            params: shader.params,
+        };
+        let bytes = std::mem::size_of::<ShaderFrame>() as u64;
+        let uniform = &uniform as *const ShaderFrame as *const c_void;
+        encoder.set_render_pipeline_state(pipeline);
+        encoder.set_vertex_bytes(0, bytes, uniform);
+        encoder.set_fragment_bytes(0, bytes, uniform);
+        let backdrop = self.backdrop.as_ref().filter(|_| shader.reads_backdrop).unwrap_or(&self.empty);
+        encoder.set_fragment_texture(0, Some(backdrop));
+        let state = shader
+            .simulation
+            .as_ref()
+            .and_then(|simulation| self.grids.get(&simulation.key))
+            .map_or(&self.empty, |grid| &grid.textures[grid.current]);
+        encoder.set_fragment_texture(1, Some(state));
+        let data = shader.data.as_ref().map(|data| {
+            let height = data.len().div_ceil(1024).max(1) as u64;
+            let descriptor = metal::TextureDescriptor::new();
+            descriptor.set_width(1024);
+            descriptor.set_height(height);
+            descriptor.set_pixel_format(MTLPixelFormat::RGBA32Float);
+            descriptor.set_storage_mode(metal::MTLStorageMode::Shared);
+            let texture = self.device.new_texture(&descriptor);
+            let mut rows = data.to_vec();
+            rows.resize(1024 * height as usize, [0.0; 4]);
+            texture.replace_region(
+                metal::MTLRegion {
+                    origin: metal::MTLOrigin { x: 0, y: 0, z: 0 },
+                    size: metal::MTLSize { width: 1024, height, depth: 1 },
+                },
+                0,
+                rows.as_ptr() as *const c_void,
+                1024 * 16,
+            );
+            texture
+        });
+        encoder.set_fragment_texture(2, Some(data.as_deref().unwrap_or(&self.empty_data)));
+        encoder.set_fragment_sampler_state(0, Some(&self.sampler));
+        encoder.set_scissor_rect(metal::MTLScissorRect {
+            x: region.origin.x,
+            y: region.origin.y,
+            width: region.size.width,
+            height: region.size.height,
+        });
+        encoder.draw_primitives(metal::MTLPrimitiveType::Triangle, 0, 6);
+        encoder.set_scissor_rect(metal::MTLScissorRect {
+            x: 0,
+            y: 0,
+            width: i32::from(viewport.width) as u64,
+            height: i32::from(viewport.height) as u64,
+        });
+    }
+}
