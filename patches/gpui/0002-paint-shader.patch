+        clipped.content_mask = ContentMask { bounds: bounds(0.0, 0.0, 10.0, 40.0) };
+        let mut scene = Scene::default();
+        scene.insert_primitive(clipped);
+        let image = render(&mut scene);
+        assert_eq!(px_at(&image, 5, 20), [0, 255, 0]);
+        assert_eq!(px_at(&image, 20, 20), [0, 0, 0]);
+    }
+}
