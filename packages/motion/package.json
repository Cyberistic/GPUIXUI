{
  "name": "@gpuixui/motion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Renderer-neutral motion physics \u2014 springs, easing, timelines and inertia \u2014 with React hooks that drive GPUix motion targets.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./timing": {
      "types": "./src/timing.ts",
      "default": "./src/timing.ts"
    },
    "./presence": {
      "types": "./src/presence.ts",
      "default": "./src/presence.ts"
    },
    "./timeline": {
      "types": "./src/timeline.ts",
      "default": "./src/timeline.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gpuixui/config": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
