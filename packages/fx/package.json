    "@gpuixui/tokens": "workspace:*",
    "@gpuixui/tw": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@gpuixui/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
