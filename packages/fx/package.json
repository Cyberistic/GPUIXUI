    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:behaviour": "vitest run --config vitest.behaviour.config.ts"
  },
  "dependencies": {
    "@gpuix/react": "catalog:",
    "@gpuixui/components": "workspace:*",
