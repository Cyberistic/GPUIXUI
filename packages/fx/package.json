{
  "name": "@gpuixui/fx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Decorative motion \u2014 particles, fireworks, stars, shine and ripple buttons, magnetic and kinetic text \u2014 built on @gpuixui/components' authoring seams, kept out of the core library (plan 726).",
