{
  "name": "@gpuixui/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tier 4 code surfaces — a highlighted editor, a diff viewer and find-and-replace — rendered by GPUix through React.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./examples/index.ts",
    "./diff/logic": "./src/diff/logic.ts",
    "./markdown/logic": "./src/markdown/logic.ts",
    "./search/logic": "./src/search/logic.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:behaviour": "vitest run --config vitest.behaviour.config.ts"
  },
  "dependencies": {
    "@gpuix/react": "catalog:",
    "@gpuixui/dock": "workspace:*",
    "@gpuixui/primitives": "workspace:*",
    "@gpuixui/tokens": "workspace:*",
    "@gpuixui/tw": "workspace:*",
    "@tanstack/highlight": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@gpuixui/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
