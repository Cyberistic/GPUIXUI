{
  "name": "@gpuixui/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Data presentation \u2014 tables, sorting, selection, filtering, virtualisation, trees and charts \u2014 rendered by GPUix through React.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./examples/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:behaviour": "vitest run --config vitest.behaviour.config.ts"
  },
  "dependencies": {
    "@gpuix/react": "catalog:",
    "@gpuixui/components": "workspace:*",
    "@gpuixui/icons": "workspace:*",
    "@gpuixui/primitives": "workspace:*",
    "@gpuixui/tokens": "workspace:*",
    "@gpuixui/tw": "workspace:*",
    "@tanstack/pacer": "catalog:",
    "@tanstack/table-core": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@gpuixui/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
