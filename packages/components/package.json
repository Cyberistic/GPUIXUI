{
  "name": "@gpuixui/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Composable Tier 2 UI components rendered by GPUix through React.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
