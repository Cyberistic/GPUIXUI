{
  "name": "@gpuixui/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Composable Tier 2 UI components rendered by GPUix through React.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./accordion": "./src/accordion.tsx",
    "./alert": "./src/alert.tsx",
    "./avatar": "./src/avatar.tsx",
    "./badge": "./src/badge.tsx",
    "./breadcrumb": "./src/breadcrumb.tsx",
    "./card": "./src/card.tsx",
    "./carousel": "./src/carousel.tsx",
    "./chat": "./src/chat.tsx",
    "./collapsible": "./src/collapsible.tsx",
    "./color-picker": "./src/color-picker.tsx",
    "./combobox": "./src/combobox.tsx",
    "./command-menu": "./src/command-menu.tsx",
    "./confirm-dialog": "./src/confirm-dialog.tsx",
    "./context-menu": "./src/context-menu.tsx",
    "./countdown": "./src/countdown.tsx",
    "./date-picker": "./src/date-picker.tsx",
    "./dialog": "./src/dialog.tsx",
    "./drawer": "./src/drawer.tsx",
    "./dropdown-menu": "./src/dropdown-menu.tsx",
    "./empty-state": "./src/empty-state.tsx",
    "./field": "./src/field.tsx",
    "./fieldset": "./src/fieldset.tsx",
    "./form": "./src/form.tsx",
    "./hotkey-recorder": "./src/hotkey-recorder.tsx",
    "./inline-edit": "./src/inline-edit.tsx",
    "./keyboard-shortcuts": "./src/keyboard-shortcuts.tsx",
    "./list": "./src/list.tsx",
    "./mention-input": "./src/mention-input.tsx",
    "./message": "./src/message.tsx",
    "./message-scroller": "./src/message-scroller.tsx",
    "./multi-step-form": "./src/multi-step-form.tsx",
    "./navigation-menu": "./src/navigation-menu.tsx",
    "./pagination": "./src/pagination.tsx",
    "./popover": "./src/popover.tsx",
    "./preview-card": "./src/preview-card.tsx",
    "./search-input": "./src/search-input.tsx",
    "./stepper": "./src/stepper.tsx",
    "./tabs": "./src/tabs.tsx",
    "./tag-input": "./src/tag-input.tsx",
    "./time-picker": "./src/time-picker.tsx",
    "./timeline": "./src/timeline.tsx",
    "./toast": "./src/toast.tsx",
    "./validation/logic": "./src/validation/logic.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:behaviour": "vitest run --config vitest.behaviour.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@gpuix/react": "0.10.0",
    "@gpuixui/icons": "workspace:*",
    "@gpuixui/tokens": "workspace:*",
    "@gpuixui/tw": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@gpuixui/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
