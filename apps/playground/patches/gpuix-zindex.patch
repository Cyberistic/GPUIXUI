+    /// Guards the `zIndex` extension: a positioned sibling paints above the
+    /// in-flow children, and positioned siblings sort by level while the
+    /// in-flow ones keep their tree order.
+    #[test]
+    fn z_index_orders_positioned_siblings_above_in_flow() {
+        let mut tree = RetainedTree::new();
+        for id in 1..=4 {
+            tree.create_element(id, "div".to_string());
+        }
+        for child in [2, 3, 4] {
+            tree.append_child(1, child);
+        }
+        tree.set_style(2, style_json(r#"{"position":"absolute","zIndex":2}"#));
+        tree.set_style(3, style_json(r#"{"width":100}"#));
+        tree.set_style(4, style_json(r#"{"position":"absolute","zIndex":1}"#));
+
+        assert_eq!(
+            tree.paint_order(&[2, 3, 4]).as_ref(),
+            &[3, 4, 2],
+            "in-flow first, then the positioned boxes by level"
+        );
+    }
+
+    /// A tree that never declares a `zIndex` must paint exactly as before:
+    /// a positioned child keeps its place in tree order.
+    #[test]
+    fn no_z_index_leaves_the_paint_order_alone() {
+        let mut tree = RetainedTree::new();
+        for id in 1..=4 {
+            tree.create_element(id, "div".to_string());
+        }
+        for child in [2, 3, 4] {
+            tree.append_child(1, child);
+        }
+        tree.set_style(2, style_json(r#"{"position":"absolute"}"#));
+        tree.set_style(3, style_json(r#"{"width":100}"#));
+        tree.set_style(4, style_json(r#"{"position":"fixed"}"#));
+
+        assert_eq!(tree.paint_order(&[2, 3, 4]).as_ref(), &[2, 3, 4]);
+    }
+
+    /// The hit walk must reverse the renderer's order, or a click lands on the
+    /// later tree sibling instead of the element painted on top.
+    #[test]
+    fn z_index_hit_order_is_reverse_paint_order() {
+        let mut tree = RetainedTree::new();
+        for id in 1..=4 {
+            tree.create_element(id, "div".to_string());
+        }
+        tree.set_root(1);
+        for child in [2, 3, 4] {
+            tree.append_child(1, child);
+        }
+        let full = style_json(r#"{"width":100,"height":100}"#);
+        tree.set_style(1, full.clone());
+        tree.set_style(2, style_json(r#"{"position":"absolute","zIndex":2}"#));
+        tree.set_style(3, full);
+        tree.set_style(4, style_json(r#"{"position":"absolute","zIndex":1}"#));
+        let boxes = [
+            (1, (0.0, 0.0, 100.0, 100.0)),
+            (2, (0.0, 0.0, 100.0, 100.0)),
+            (3, (0.0, 0.0, 100.0, 100.0)),
+            (4, (0.0, 0.0, 100.0, 100.0)),
+        ];
+
+        assert_eq!(
+            tree.elements_at(50.0, 50.0, &boxed(&boxes)),
+            vec![2, 4, 3, 1]
+        );
+    }
