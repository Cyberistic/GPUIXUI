+    /// Paint order of a parent's children, bottom to top.
+    ///
+    /// In-flow children keep their tree order and paint first; `absolute` and
+    /// `fixed` children paint after them, stable-sorted by `zIndex` (unset is
+    /// 0). While no positioned child declares a `zIndex`, the tree order comes
+    /// back untouched, so existing trees paint exactly as they did and nothing
+    /// pays for a sort it does not use.
+    ///
+    /// Layout is unaffected: only out-of-flow children move, and their position
+    /// comes from their insets, not their index.
+    pub fn paint_order<'a>(&self, children: &'a [u64]) -> Cow<'a, [u64]> {
+        let style = |id: u64| {
+            self.elements
+                .get(&id)
+                .and_then(|element| element.style.as_deref())
+        };
+        let out_of_flow = |id: u64| {
+            matches!(
+                style(id).and_then(|style| style.position.as_deref()),
+                Some("absolute" | "fixed")
+            )
+        };
+        let z_index = |id: u64| {
+            style(id)
+                .filter(|_| out_of_flow(id))
+                .and_then(|style| style.z_index)
+        };
+
+        if !children.iter().any(|id| z_index(*id).is_some()) {
+            return Cow::Borrowed(children);
+        }
+
+        let (in_flow, positioned): (Vec<u64>, Vec<u64>) = children
+            .iter()
+            .copied()
+            .partition(|id| !out_of_flow(*id));
+        let mut positioned = positioned;
+        positioned.sort_by_key(|id| z_index(*id).unwrap_or(0));
+        let mut ordered = in_flow;
+        ordered.extend(positioned);
+        Cow::Owned(ordered)
+    }
