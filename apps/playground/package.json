{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nub run --filter @gpuixui/testing build && tsc -p tsconfig.build.json",
    "dev": "nub run build && nub watch dist/main.js",
    "smoke": "nub run build && nub dist/smoke/run.js",
    "terminal": "nub run build && nub dist/terminal/run.js",
    "bundle": "nub run build && nub scripts/bundle.ts",
    "start": "nub run bundle && nub dist/bundle/start.mjs",
    "bench:launch": "nub run bundle && caffeinate -du nub dist/launch/run.js",
    "check-types": "nub run --filter @gpuixui/testing build && tsc -p tsconfig.check.json",
    "test": "nub run --filter @gpuixui/testing build && vitest run"
  },
  "dependencies": {
    "@gpuix/native": "catalog:",
    "@gpuix/react": "catalog:",
    "@gpuixui/blocks": "workspace:*",
    "@gpuixui/components": "workspace:*",
    "@gpuixui/data": "workspace:*",
    "@gpuixui/dock": "workspace:*",
    "@gpuixui/editor": "workspace:*",
    "@gpuixui/files": "workspace:*",
    "@gpuixui/fx": "workspace:*",
    "@gpuixui/icons": "workspace:*",
    "@gpuixui/media": "workspace:*",
    "@gpuixui/motion": "workspace:*",
    "@gpuixui/primitives": "workspace:*",
    "@gpuixui/shell": "workspace:*",
    "@gpuixui/slang": "workspace:*",
    "@gpuixui/testing": "workspace:*",
    "@gpuixui/tokens": "workspace:*",
    "effect": "catalog:",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@gpuixui/config": "workspace:*",
    "@orpc/client": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@tanstack/ai": "^1.2.0",
    "@tanstack/ai-react": "^1.0.2",
    "@tanstack/db": "^1.0.0-rc.1.3",
    "@tanstack/react-db": "^1.0.0-rc.1.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "better-auth": "^1.7.17",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
