{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nub run --filter @gpuixui/testing build && tsc -p tsconfig.build.json",
    "dev": "nub run build && nub watch dist/main.js",
    "smoke": "nub run build && nub dist/smoke/run.js",
    "check-types": "nub run --filter @gpuixui/testing build && tsc -p tsconfig.check.json",
    "test": "nub run --filter @gpuixui/testing build && vitest run"
  },
  "dependencies": {
    "@gpuix/native": "catalog:",
    "@gpuix/react": "catalog:",
    "@gpuixui/testing": "workspace:*",
    "@gpuixui/tokens": "workspace:*",
    "effect": "catalog:",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@gpuixui/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
