{
  "extends": "@gpuixui/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@gpuix/native/wasm/*": ["./node_modules/@gpuix/native/wasm/*"]
    },
    "noEmit": true
  },
  "include": [
    "src",
    "content",
    "plugins",
    "scripts",
    "source.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    ".source"
  ]
}
