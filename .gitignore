# Dependencies
node_modules/

# Build / cache artifacts (all workspaces)
dist/
build/
.source/
*.tsbuildinfo

# Alchemy deploy state
.alchemy/

# Reference clones (AGENTS.md) — read-only, never repository content
references/

# Per-agent working copies of the whole repo. Never repository content: one
# writer per tree, and a second copy inside the repo breaks lint/knip.
workspaces/

# Agent scratch and transient session logs — never repository content
.agents/slop/*.log
.agents/slop/swarm/
.agents/slop/swarm-model.state
.scratch/

# Environment variables
.env
.env.keys

# OS / editor
.DS_Store

# Agent scratch under .agents/slop (tooling, downloaded tarballs, extracted
# reference packages). Agent state, never repository content.
.agents/slop/scratch/
.agents/slop/rd/

# The read-only reference clone is a local symlink, not repository content.
references
