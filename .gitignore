# Dependencies
node_modules/

# Build / cache artifacts (all workspaces)
dist/
build/
.source/
*.tsbuildinfo

# Alchemy deploy state
.alchemy/

# Reference clones (AGENTS.md) — read-only, never repository content
references/

# Per-agent working copies of the whole repo. Never repository content: one
# writer per tree, and a second copy inside the repo breaks lint/knip.
workspaces/

# Agent scratch and transient session logs — never repository content
.agents/slop/*.log
.agents/slop/swarm/
.agents/slop/swarm-model.state
.scratch/

# Environment variables
.env
.env.keys

# OS / editor
.DS_Store

# Agent scratch under .agents/slop (tooling, downloaded tarballs, extracted
# reference packages). Agent state, never repository content.
.agents/slop/scratch/
.agents/slop/rd/

# The read-only reference clone is a local symlink, not repository content.
references

# Tooling backups
*.bak-*
*.bak

# Agent screenshot artifacts — verification only, never repository content
.agents/slop/dashboard/

# Frames the live probes capture (docs and playground). Local evidence for a
# run: read them, then delete them; nothing here is repository content.
.artifacts/

# salvage queue (working state; originals live in the salvage/* tags)
.agents/slop/salvage-queue/

# The launch film's render output. The cut is reproducible from
# `media/launch/build/` (README there has the four commands); the frames and the
# encoded file are artefacts, not repository content.
media/launch/gpuixui-launch.mp4
media/launch/stills/
media/launch/frames/
media/launch/audio/
