{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.alchemy/**",
    "**/.source/**",
    "**/references/**",
    "**/workspaces/**",
    "apps/docs/src/routeTree.gen.ts"
  ],
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
